{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "pandu/nikaido",
    "type": "project",
    "description": "Pandu/Nikaido — A Laravel-based framework for systematic trading and investment strategy research, backtesting, and robustness analysis.",
    "keywords": ["laravel", "framework", "trading", "backtest", "systematic-trading", "quant", "quantitative-finance"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "laravel/framework": "^12.0",
        "laravel/tinker": "^2.10.1",
        "pandu/exact": "^2.2.0",
        "pandu/gauss": "^0.3.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pail": "^1.2.2",
        "laravel/pint": "^1.24",
        "laravel/sail": "^1.41",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^11.5.50"
    },
    "autoload": {
        "psr-4": {
            "App\\Feature\\": "laravel/app/Feature/",
            "App\\": "laravel/app/",
            "Nikaido\\": "src/",
            "Database\\Factories\\": "laravel/database/factories/",
            "Database\\Seeders\\": "laravel/database/seeders/"
        },
        "files": [
            "src/main.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "laravel/tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php -r \"file_exists('laravel/database/database.sqlite') || touch('laravel/database/database.sqlite');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm --prefix laravel install",
            "npm --prefix laravel run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npm --prefix laravel run dev:all"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "@php artisan clear-compiled",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan clear-compiled",
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('laravel/database/database.sqlite') || touch('laravel/database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
